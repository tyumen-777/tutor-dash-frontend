# Base URL used by Axios at runtime (without an endpoint path).
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional: override the OpenAPI document URL used by Orval.
OPENAPI_URL=http://localhost:4000/api

# Production (edudash.org): NEXT_PUBLIC_API_URL=https://api.edudash.org
# Передаётся как build arg — значение вшивается в бандл при сборке.
